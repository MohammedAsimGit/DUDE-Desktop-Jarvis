# Dude configuration — Phase 0.
# Copy to .env (git-ignored) to override defaults. NEVER put real secrets here
# or in .env — this project has no secrets in Phase 0.
#
# This file is a placeholder: in Phase 0 the configuration foundations are the
# Python engine's `dude.config` module and the Rust host's compile-time/dev
# settings. Environment variables below are *reserved* and documented for later
# phases; none are required today.

# ── Reserved (Phase 0: documented placeholder only) ──────────
# DUDE_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR (engine)
# DUDE_DATA_DIR=                 # Per-user data dir; defaults to %LOCALAPPDATA%/Dude
