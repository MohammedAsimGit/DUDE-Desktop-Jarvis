[ENGINE]
# Dude configuration — copy to .env (git-ignored) to override defaults.
# NEVER put real secrets in this file or in any committed file. The API key
# for the optional cloud provider lives only in .env or the real environment.

# ── Engine (existing) ────────────────────────────────────────
DUDE_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR (engine)
# DUDE_DATA_DIR=                # Per-user data dir; defaults to %LOCALAPPDATA%/Dude

# ── AI provider (Sprint 3, optional; opt-in) ─────────────────
# By default Dude uses a deterministic, non-AI local fallback that answers
# simple prompts without sending anything anywhere. To enable an
# OpenAI-compatible cloud provider you must set BOTH:
#
#   DUDE_AI_PROVIDER=openai
#   OPENAI_API_KEY=<your key, never committed>
#
# When both are set, conversation text (the in-session context plus your
# submitted message) is sent to the configured chat-completions endpoint —
# it leaves the device. Microphone audio is never sent. Remove either
# variable to return to the all-local fallback.
#
# Optional (OpenAI-compatible servers, e.g. a self-hosted local endpoint):
#   DUDE_AI_BASE_URL=https://api.openai.com/v1
#   DUDE_AI_MODEL=gpt-4o-mini
